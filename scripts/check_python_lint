#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

RUFF="${PROJECT_ROOT}/venv/bin/ruff"
if [ ! -x "$RUFF" ]; then
    echo "ruff not found in venv, skipping lint check" >&2
    exit 0
fi

exec "$RUFF" check \
    "${PROJECT_ROOT}/scripts" \
    "${PROJECT_ROOT}/simulation" \
    "${PROJECT_ROOT}/training" \
    "${PROJECT_ROOT}/firmware"
