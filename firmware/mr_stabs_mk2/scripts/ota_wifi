#!/bin/bash
# Flash over the robot's SoftAP with ArduinoOTA. Connect to the MR-STABS network first. Phase 1
# fallback while ESP-NOW OTA (scripts/ota) proves itself; Phase 2 of
# docs/plans/espnow_link_plan.md deletes the SoftAP and this script with it.
BASE_DIR=$(realpath "$(dirname $0)")
cd ${BASE_DIR}/..
platformio run --target upload -e ota --upload-port 192.168.4.1
