[Unit]
Description=Foxglove WebSocket relay for auto_battlebot
After=network.target

[Service]
Type=simple
# Installed by 'make install' next to auto_battlebot (default prefix ~/.local). Port 80 so the
# dashboard is http://<hostname>.local with no port; a dev box runs scripts/run_viz_relay.sh on the
# default 8080 instead. The capability lives here, not as setcap on the binary, so 'cmake --install'
# cannot drop it, and the relay never runs as root.
ExecStart=/home/__USER__/.local/bin/viz_relay --http-port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
WorkingDirectory=/home/__USER__/auto-battlebot
Restart=always
RestartSec=2
# The relay bounds its own shutdown to about 2 s even with a client whose network vanished; this
# only matters if that ever regresses. The default 90 s is how long a stuck stop used to take.
TimeoutStopSec=10
User=__USER__
SyslogIdentifier=viz_relay
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
