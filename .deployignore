# Paths excluded from scripts/deploy_to_jetson.sh, on top of .gitignore.
#
# Syntax follows .gitignore/.dockerignore:
#   pattern      exclude it
#   /pattern     anchor to the repo root
#   pattern/     directories only
#   !pattern     re-include something an earlier rule (or .gitignore) excluded
#   # comment    ignored
#
# Two rsync notes:
#   - Excluding a path here does not delete an already-deployed copy on the
#     Jetson. Remove it there by hand once.
#   - To re-include a file inside an excluded directory, re-include the
#     directory first: "!config/", then "!config/keep.toml".

# Examples:
/docs/
# /logo/ stays: CMakeLists.txt embeds bwbots_splash_1024x600.gif and
# bwbots_logo_dark_h24.png into the binary via cmake/bin2c.cmake, and the Jetson builds
# from source. The whole directory is 568K, so it ships rather than a two-file re-include
# that would break silently the next time an asset is embedded.
/stickers/
/.claude/
/.serena/
/build/
/build-test/
/build-docker/
# Foxglove SDK is architecture-specific; the Jetson installs its own via
# scripts/install_jetson.sh.
/third_party/

# The root .gitignore excludes every lib/ directory, and git re-includes the dashboard's
# web/src/lib/ with "!/web/src/lib/". rsync's .gitignore merge reads that line as a plain
# exclude, so the re-include has to live here or the web build fails on the Jetson.
!/web/src/lib/
