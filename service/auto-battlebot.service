[Unit]
Description=Auto BattleBot autonomous robot control
# After= only, never Requires= or ExecStartPre=: the app must start whether or not the relay is
# up. It connects to the relay's unix socket on its own and reconnects when the relay restarts.
After=network.target viz-relay.service

[Service]
Type=simple
# Binary from 'make install' (default prefix ~/.local). Override with:
#   systemctl edit auto-battlebot.service  and set ExecStart=
# Uses same layout as scripts/build_and_install.sh (default prefix ~/.local)
# No -c: the active profile is resolved from the web page's selection (persisted outside the
# repo), falling back to config/default_profile. See config/profiles.toml. The app opens no
# window; dashboard-kiosk.service puts the web page on the box's screen.
ExecStart=/home/__USER__/.local/bin/auto_battlebot
WorkingDirectory=/home/__USER__/auto-battlebot
Restart=always
RestartSec=30
User=__USER__
SupplementaryGroups=dialout
SyslogIdentifier=auto_battlebot
StandardOutput=journal
StandardError=journal
# HOME must be set: the profile selection is persisted to $HOME/.local/state/... and an unset
# HOME would resolve it relative to WorkingDirectory (inside the repo), where the next deploy
# wipes it.
Environment="HOME=/home/__USER__"

[Install]
WantedBy=multi-user.target
