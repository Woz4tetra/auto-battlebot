#!/bin/bash

usage() {
    cat <<'EOF'
lint: format the tree and run every lint / type check in one pass.

This is the single entry point for formatting and static checks.

Steps (in order):
  1. clang-format   C/C++ under src/ include/ tests/ firmware/  (apply, or --dry-run check)
  2. taplo          TOML under config/                  (apply, or --dry-run check)
  3. ruff format    Python under scripts/ etc.          (apply, or --dry-run check)
  4. ruff check     Python lint                         (report)
  5. protocol.ts    web/src/generated/protocol.ts from remote_protocol_dump (regenerate,
                    or --dry-run check; needs build/ and web/node_modules)
  6. prettier       web/src, firmware web pages         (apply, or --dry-run check)
  7. clang-tidy     C/C++ lint over src/  [cached]      (report; needs build/)
  8. mypy           Python type check (scope from mypy.ini)  [slow]
  9. svelte-check   web/ types  [slow]

Options:
  --dry-run   Do not modify files: check formatting instead of applying it,
              so the run is a pure pass/fail gate (use in CI / hooks).
  --quick     Skip the slow checks (clang-tidy and mypy) for fast iteration.
  -h, --help  Show this help.

Every step runs even if an earlier one fails; the script exits non-zero if any
check failed.
EOF
}

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
BUILD_DIR="$PROJECT_ROOT/build"

DRY_RUN=false
QUICK=false
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
        --quick) QUICK=true ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $arg (try --help)" >&2
            exit 2
            ;;
    esac
done

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
DIM='\033[2m'
NC='\033[0m'

# taplo logs an INFO line listing every file it visits to stderr on every run,
# pass or fail. The Stop hook only surfaces stderr, so that noise buries the
# real failure. Drop it to warnings unless the caller asked for more.
export RUST_LOG="${RUST_LOG:-warn}"

VENV_BIN="$PROJECT_ROOT/venv/bin"
if [ -d "$VENV_BIN" ]; then
    export PATH="$VENV_BIN:$PATH"
fi

FAILED=()

have() { command -v "$1" >/dev/null 2>&1; }

resolve_pinned_llvm() {
    LLVM_VERSION=$(tr -d '[:space:]' < "$PROJECT_ROOT/.llvm-version" 2>/dev/null || true)
}
resolve_pinned_llvm

pinned_llvm_tool() {
    local name="$1"
    [ -n "$LLVM_VERSION" ] || return 1
    if have "$name-$LLVM_VERSION"; then
        echo "$name-$LLVM_VERSION"
        return 0
    fi
    if have "$name" && "$name" --version 2>/dev/null | grep -q "version $LLVM_VERSION\."; then
        echo "$name"
        return 0
    fi
    return 1
}

CLANG_FORMAT=$(pinned_llvm_tool clang-format || true)
CLANG_TIDY=$(pinned_llvm_tool clang-tidy || true)

# run-clang-tidy is a driver script, not a compiler; it has no --version, so
# take the versioned copy when it exists and pin the worker binary explicitly.
if have "run-clang-tidy-$LLVM_VERSION"; then
    RUN_CLANG_TIDY="run-clang-tidy-$LLVM_VERSION"
elif have run-clang-tidy; then
    RUN_CLANG_TIDY="run-clang-tidy"
else
    RUN_CLANG_TIDY=""
fi

LLVM_HINT="run install/install_llvm_toolchain.sh"

configure_ctcache() {
    CTCACHE_WRAPPER="$HOME/.local/share/ctcache/clang-tidy"
    if [ -n "$CLANG_TIDY" ] && [ -x "$CTCACHE_WRAPPER" ]; then
        # The wrapper execs this path directly and defaults to /usr/bin/clang-tidy,
        # so it needs the resolved binary, not the bare name.
        export CTCACHE_CLANG_TIDY="$(command -v "$CLANG_TIDY")"
        export CTCACHE_SAVE_OUTPUT=1
        export CTCACHE_DIR="${CTCACHE_DIR:-$HOME/.cache/ctcache}"
        TIDY_BINARY="$CTCACHE_WRAPPER"
    else
        TIDY_BINARY="$CLANG_TIDY"
    fi
}
configure_ctcache

FORMATTER_MODE=apply
[ "$DRY_RUN" = true ] && FORMATTER_MODE=check

header() { echo -e "${YELLOW}==> $1${NC}"; }

record() {
    local label=$1 exit_code=$2
    if [ "$exit_code" -eq 0 ]; then
        echo -e "${GREEN}    ✓ $label${NC}"
    else
        echo -e "${RED}    ✗ $label${NC}"
        FAILED+=("$label")
    fi
}

missing() { echo -e "${DIM}    - $1 (skipped: $2 not found)${NC}"; }

skipped_quick() { echo -e "${DIM}    - $1 (skipped: --quick)${NC}"; }

cpp_files() {
    find "$PROJECT_ROOT/src" "$PROJECT_ROOT/include" "$PROJECT_ROOT/tests" \
        \( -name '*.cpp' -o -name '*.hpp' -o -name '*.h' -o -name '*.c' -o -name '*.cu' \) -print0
    find "$PROJECT_ROOT/firmware" \
        \( -name .pio -o -path "$PROJECT_ROOT/firmware/BlHeli-Passthrough" \) -prune -o \
        \( -name '*.cpp' -o -name '*.hpp' -o -name '*.h' -o -name '*.c' \) -print0
}

FIRMWARE_WEB_GLOBS=(
    "../firmware/mr_stabs_mk2/web/*.{js,mjs,css,html}"
    "../firmware/espnow_dongle/scripts/espnow_diag_web/*.{js,css,html}"
)

PY_FMT_DIRS=(
    "$PROJECT_ROOT/auto_battlebot"
    "$PROJECT_ROOT/playground"
    "$PROJECT_ROOT/scripts"
    "$PROJECT_ROOT/simulation"
    "$PROJECT_ROOT/training"
    "$PROJECT_ROOT/firmware"
)

run_clang_format() {
    header "clang-format ($FORMATTER_MODE)"
    if [ -n "$CLANG_FORMAT" ]; then
        if [ "$DRY_RUN" = true ]; then
            cpp_files | xargs -0 -r "$CLANG_FORMAT" --dry-run --Werror
        else
            cpp_files | xargs -0 -r "$CLANG_FORMAT" -i
        fi
        record "clang-format" $?
    else
        missing "clang-format" "clang-format-$LLVM_VERSION ($LLVM_HINT)"
    fi
}
run_clang_format

run_taplo() {
    header "taplo ($FORMATTER_MODE)"
    if have taplo; then
        if [ "$DRY_RUN" = true ]; then
            find "$PROJECT_ROOT/config" -name '*.toml' -print0 | xargs -0 -r taplo format --check
        else
            find "$PROJECT_ROOT/config" -name '*.toml' -print0 | xargs -0 -r taplo format
        fi
        record "taplo" $?
    else
        missing "taplo" "taplo"
    fi
}
run_taplo

run_ruff_format() {
    header "ruff format ($FORMATTER_MODE)"
    if have ruff; then
        if [ "$DRY_RUN" = true ]; then
            ruff format --check "${PY_FMT_DIRS[@]}"
        else
            ruff format "${PY_FMT_DIRS[@]}"
        fi
        record "ruff format" $?
    else
        missing "ruff format" "ruff"
    fi
}
run_ruff_format

run_ruff_check() {
    header "ruff check"
    if have ruff; then
        ruff check "${PY_FMT_DIRS[@]}"
        record "ruff check" $?
    else
        missing "ruff check" "ruff"
    fi
}
run_ruff_check

# ---- 5. install scripts (shell option leaks) ----
# Install helpers are sourced into one shell, so a `set -o pipefail` or `trap` inside a helper
# silently changes every step after it. That is how a pipefail leaked from install_opencv
# killed the Jetson venv step with no message. install/fail_loudly.sh owns the traps and
# options; helpers may repeat `set -e`, and install_opencv.sh has a subshell body, so its
# options stay local.
header "install scripts"
install_leaks=$(grep -nE '^[[:space:]]*(set[[:space:]]+[-+]|trap[[:space:]])' \
    "$PROJECT_ROOT"/install/*.sh "$PROJECT_ROOT"/scripts/install_*.sh |
    grep -v '/install/fail_loudly.sh:' |
    grep -vE ':[0-9]+:[[:space:]]*set -e[[:space:]]*(#.*)?$' |
    grep -v '/install/install_opencv.sh:')
if [ -n "$install_leaks" ]; then
    echo "$install_leaks"
    echo "Move the option or trap into install/fail_loudly.sh, or scope it in a subshell."
    record "install scripts" 1
else
    record "install scripts" 0
fi

header "comment budget"
COMMENT_BUDGET=(python3 "$SCRIPT_DIR/comment_budget.py" --root "$PROJECT_ROOT")
"${COMMENT_BUDGET[@]}" check
comment_rc=$?
if [ $comment_rc -eq 0 ] && [ "$DRY_RUN" = false ]; then
    "${COMMENT_BUDGET[@]}" ratchet
    [ -n "$(git -C "$PROJECT_ROOT" config core.hooksPath)" ] ||
        git -C "$PROJECT_ROOT" config core.hooksPath scripts/git-hooks
fi
record "comment budget" $comment_rc

WEB_DIR="$PROJECT_ROOT/web"
PROTOCOL_TS="$WEB_DIR/src/generated/protocol.ts"
PROTOCOL_DUMP="$BUILD_DIR/remote_protocol_dump"
have_web() { have node && [ -d "$WEB_DIR/node_modules" ]; }
run_protocol_codegen_check() {
    header "protocol.ts ($FORMATTER_MODE)"
    if ! have_web; then
        missing "protocol.ts" "web/node_modules (run scripts/build_web.sh)"
    elif [ ! -x "$PROTOCOL_DUMP" ]; then
        echo -e "${RED}    ✗ protocol.ts (no build/remote_protocol_dump; run scripts/build.sh)${NC}"
        FAILED+=("protocol.ts")
    else
        DUMP_JSON=$(mktemp)
        "$PROTOCOL_DUMP" >"$DUMP_JSON"
        if [ "$DRY_RUN" = true ]; then
            BEFORE=$(mktemp)
            cp "$PROTOCOL_TS" "$BEFORE" 2>/dev/null || : >"$BEFORE"
            (cd "$WEB_DIR" && node scripts/gen-protocol.mjs "$DUMP_JSON" >/dev/null)
            cmp -s "$BEFORE" "$PROTOCOL_TS"
            rc=$?
            cp "$BEFORE" "$PROTOCOL_TS"
            rm -f "$BEFORE"
            [ $rc -ne 0 ] && echo "    protocol.ts is stale; run scripts/lint to regenerate it"
            record "protocol.ts" $rc
        else
            (cd "$WEB_DIR" && node scripts/gen-protocol.mjs "$DUMP_JSON" >/dev/null)
            record "protocol.ts" $?
        fi
        rm -f "$DUMP_JSON"
    fi
}
run_protocol_codegen_check

run_prettier() {
    header "prettier ($FORMATTER_MODE)"
    if have_web; then
        if [ "$DRY_RUN" = true ]; then
            (cd "$WEB_DIR" && npx --no-install prettier --check --config .prettierrc src \
                "${FIRMWARE_WEB_GLOBS[@]}")
        else
            (cd "$WEB_DIR" && npx --no-install prettier --write --log-level warn --config .prettierrc \
                src "${FIRMWARE_WEB_GLOBS[@]}")
        fi
        record "prettier" $?
    else
        missing "prettier" "web/node_modules (run scripts/build_web.sh)"
    fi
}
run_prettier

refresh_compile_commands_after_renames() {
    if ! cmake -S "$PROJECT_ROOT" -B "$BUILD_DIR" >/dev/null; then
        echo -e "${RED}    ✗ cmake reconfigure of build/ failed${NC}"
    fi
}

run_clang_tidy() {
    header "clang-tidy"
    if [ "$QUICK" = true ]; then
        skipped_quick "clang-tidy"
    elif [ -z "$RUN_CLANG_TIDY" ] || [ -z "$CLANG_TIDY" ]; then
        missing "clang-tidy" "clang-tidy-$LLVM_VERSION ($LLVM_HINT)"
    elif [ ! -f "$BUILD_DIR/compile_commands.json" ]; then
        echo -e "${RED}    ✗ clang-tidy (no build/compile_commands.json — run scripts/build.sh)${NC}"
        FAILED+=("clang-tidy")
    else
        refresh_compile_commands_after_renames
        "$RUN_CLANG_TIDY" -p "$BUILD_DIR" -clang-tidy-binary "$TIDY_BINARY" \
            -warnings-as-errors='*' "^${PROJECT_ROOT}/src/.*\.cpp$"
        record "clang-tidy" $?
    fi
}
run_clang_tidy

run_mypy() {
    header "mypy"
    if [ "$QUICK" = true ]; then
        skipped_quick "mypy"
    elif have mypy; then
        (cd "$PROJECT_ROOT" && mypy)
        record "mypy" $?
    else
        missing "mypy" "mypy"
    fi
}
run_mypy

run_svelte_check() {
    header "svelte-check"
    if [ "$QUICK" = true ]; then
        skipped_quick "svelte-check"
    elif have_web; then
        (cd "$WEB_DIR" && npx --no-install svelte-check --tsconfig ./tsconfig.json --fail-on-warnings)
        record "svelte-check" $?
    else
        missing "svelte-check" "web/node_modules (run scripts/build_web.sh)"
    fi
}
run_svelte_check

echo "========================================"
if [ ${#FAILED[@]} -eq 0 ]; then
    echo -e "${GREEN}All checks passed.${NC}"
    exit 0
else
    echo -e "${RED}Failed: ${FAILED[*]}${NC}"
    exit 1
fi
