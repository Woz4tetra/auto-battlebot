{
  "permissions": {
    "allow": [
      "Bash(ruff check *)",
      "Bash(mypy *)",
      "Bash(./scripts/no_ai_slop_check.sh)",
      "Bash(bash scripts/no_ai_slop_check.sh)",
      "Bash(nvidia-smi --query-gpu=*)",
      "Bash(nvidia-smi --query-compute-apps=*)",
      "Bash(journalctl -b *)",
      "Bash(journalctl -u *)",
      "Bash(ffprobe *)",
      "Bash(venv/bin/python training/gpu_queue.py status*)",
      "Bash(tar tf *)",
      "Bash(./scripts/lint --dry-run *)",
      "Bash(./scripts/lint --quick --dry-run *)",
      "mcp__firecrawl__firecrawl_scrape",
      "mcp__context7__query-docs",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_symbol",
      "mcp__serena__initial_instructions"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/venv/bin/python -m auto_battlebot.verify.hooks stop",
            "timeout": 1800,
            "statusMessage": "Running scripts/verify --fast --changed"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/venv/bin/python -m auto_battlebot.verify.hooks touch"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/no_ai_slop_check.sh",
            "statusMessage": "Checking wording"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/comment_budget.py --root \"$CLAUDE_PROJECT_DIR\" hook",
            "statusMessage": "Checking comment budget"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "verifier",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/venv/bin/python -m auto_battlebot.verify.hooks subagent-stop",
            "statusMessage": "Recording verifier verdict"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/venv/bin/python -m auto_battlebot.verify.hooks bash-guard",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  }
}
